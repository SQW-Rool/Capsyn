<?xml version="1.0" encoding="utf-8"?>
<!--
    Capsyn Prism —— 看板视觉体系（重做版）。

    设计语言（参考多家 Windows 灵动岛项目后自定的规范）：
      * 材质：深色玻璃 —— 顶部 1px 高光 + 渐变玻璃底 + 细描边，强调色用径向辉光；
      * 形状：胶囊 = 高度一半，卡片 = 20，按钮 = 14/18，分段 = 16；
      * 字阶：标题 16 SemiBold / 正文 12.5 / 说明 11 / 数字用 Cascadia Mono；
      * 状态色：蓝（默认）· 青（网络）· 紫（闹钟）· 橙（倒计时）· 红（提醒）。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== 玻璃卡片 ==================== -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardGlassBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="GlassCard" TargetType="Border" BasedOn="{StaticResource CardBorder}" />

    <Style x:Key="CardLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
    </Style>

    <Style x:Key="CardValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontFamily" Value="Cascadia Mono" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
    </Style>

    <!-- ==================== 指标 / 网络 ==================== -->
    <Style x:Key="BarTrack" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RingTrackBrush}" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style x:Key="BarFill" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MetricNetworkTintBrush}" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- ==================== 图标按钮 ==================== -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Background" Value="{StaticResource CardGlassBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="CloseIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Background" Value="{ThemeResource CriticalTintWeakBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CriticalTintStrongBrush}" />
    </Style>

    <Style x:Key="GhostCaptionButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- ==================== 带文字按钮 ==================== -->
    <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{StaticResource CardGlassBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="StopwatchToolStyle" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Background" Value="{ThemeResource AccentTintWeakBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentTintStrongBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextBrush}" />
    </Style>

    <Style x:Key="CountdownToolStyle" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Background" Value="{ThemeResource WarningTintWeakBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource WarningTintStrongBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource WarningTextBrush}" />
    </Style>

    <Style x:Key="AlarmToolStyle" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Background" Value="{ThemeResource SecondaryAccentTintWeakBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SecondaryAccentTintStrongBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryAccentTextBrush}" />
    </Style>

    <!-- 按钮四态：压成玻璃高光，而不是系统灰块 -->
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2BFFFFFF" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{ThemeResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#45FFFFFF" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#45FFFFFF" />

    <!-- ==================== 时间工具 ==================== -->
    <Style x:Key="SegmentFrame" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardGlassBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style x:Key="SegmentButton" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="PresetChip" TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{StaticResource CardGlassBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="PrimaryActionButton" TargetType="Button">
        <Setter Property="Height" Value="44" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{ThemeResource AccentTintStrongBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentTintMaxBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SecondaryActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
        <Setter Property="Background" Value="{StaticResource CardGlassBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>

    <!-- ==================== 文字层级 ==================== -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HeroReadout" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="56" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
    </Style>

    <Style x:Key="HeroCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
    </Style>

    <Style x:Key="ToolsTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
