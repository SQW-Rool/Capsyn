<?xml version="1.0" encoding="utf-8"?>
<!--
    看板（DashboardIslandControl）用到的样式，从页面里抽出来集中放这里（结构整理第 ① 步，纯搬移）。
    依据：WinUI 的 StaticResource 会沿树上溯到 Application.Resources，所以页面里照旧写
    {StaticResource CardBorder} 即可，不需要改页面 —— 只是定义搬到了这一处，便于复用与查找。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <!--
            Phase 2：这组样式全部走 Themes/Tokens.xaml 的 token（不再写字面数值），
            并补齐 Disabled 状态与卡片阴影。
            依据：[WinUI Gallery](https://github.com/microsoft/WinUI-Gallery) 的官方控件样式
            （按钮四态用标准资源键覆盖）+ [Materials / Fluent 层级](https://learn.microsoft.com/en-us/windows/apps/develop/ui/materials)。
        -->

        <!-- 卡片阴影：Fluent 的层级感（ThemeShadow 需要 Translation 抬 Z 才看得出来） -->

        <!-- 卡片：半透明白底 + 细描边，压在看板的纯黑底上 -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource CornerRadiusLarge}" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{ThemeResource TypeCaptionSize}" />
            <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
        </Style>

        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{ThemeResource TypeSubtitleSize}" />
            <Setter Property="FontFamily" Value="Cascadia Code" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="BarTrack" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleHoverBrush}" />
            <Setter Property="CornerRadius" Value="{ThemeResource CornerRadiusSmall}" />
        </Style>

        <Style x:Key="BarFill" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource MetricNetworkTintBrush}" />
            <Setter Property="CornerRadius" Value="{ThemeResource CornerRadiusSmall}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- 右下角的圆形图标按钮：40 × 40（8px 网格），只有图标没有文字，几个按钮共用这套尺寸 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="{ThemeResource CornerRadiusPill}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- 「关闭程序」是危险动作：在 IconButton 基础上换成红底 / 红边 -->
        <Style x:Key="CloseIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="{ThemeResource CriticalTintWeakBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CriticalTintStrongBrush}" />
        </Style>

        <!-- 带文字的功能按钮：「时间工具」和三个工具按钮共用 -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="{ThemeResource SpacingInsetMedium}" />
            <Setter Property="CornerRadius" Value="{ThemeResource CornerRadiusMedium}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="{ThemeResource TypeBodySize}" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!--
            三个工具按钮各一个色系（iOS 深色模式取色），一眼能区分：
              正计时 = 蓝 #0A84FF / 倒计时 = 橙 #FF9F0A / 闹钟 = 紫 #BF5AF2
            底色淡染（18%）+ 彩色描边 + 亮色文字，和「关闭程序」那套红是同一个做法。
        -->
        <Style x:Key="StopwatchToolStyle" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="{ThemeResource AccentTintWeakBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentTintStrongBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextBrush}" />
        </Style>

        <Style x:Key="CountdownToolStyle" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="{ThemeResource WarningTintWeakBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource WarningTintStrongBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource WarningTextBrush}" />
        </Style>

        <Style x:Key="AlarmToolStyle" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="{ThemeResource SecondaryAccentTintWeakBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SecondaryAccentTintStrongBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource SecondaryAccentTextBrush}" />
        </Style>

        <!--
            把默认按钮态的刷子刷成半透明白，免得在纯黑底上出现浅色主题的灰块。
            依据：WinUI 按钮模板用的就是这些标准资源键，覆盖它们即可统一四态（含 Disabled）。
        -->
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SubtleHoverColor}" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SubtlePressedColor}" />
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource CardBackgroundColor}" />
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{ThemeResource TextTertiaryColor}" />
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource SubtleBorderHoverColor}" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource SubtleBorderHoverColor}" />
</ResourceDictionary>
