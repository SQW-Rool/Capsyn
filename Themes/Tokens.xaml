<?xml version="1.0" encoding="utf-8"?>
<!--
    视觉 token 字典（Phase 1）—— 颜色 / 圆角 / 间距 / 字体层级 / 图标尺寸 / 动效时长与缓动。

    依据（可追溯）：
      * 颜色与主题：[Materials overview](https://learn.microsoft.com/en-us/windows/apps/develop/ui/materials)
        + WinUI 3 主题资源体系（ThemeResource / ThemeDictionaries：Light / Dark / HighContrast）
      * 字体层级：[Fluent 2 Typography](https://fluent2.microsoft.design/typography)
      * 动效时长与缓动：[Motion in practice](https://learn.microsoft.com/en-us/windows/apps/develop/motion/motion-in-practice)
      * 图标：[Segoe Fluent Icons](https://learn.microsoft.com/en-us/windows/apps/design/style/segoe-fluent-icons-font)

    结构规则（重要，避免踩过的坑）：
      1. `ThemeDictionaries` 里的三个字典**各自都要写全同一组 key**（这是正确写法，不是重复 ✗）；
      2. **外层**（ThemeDictionaries 之外）的 x:Key 必须全局唯一 —— 外层重复会导致 XAML 编译失败。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ==================== Dark（项目固定使用的主题；色值 = 迁移前的硬编码值） ==================== -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="IslandSurfaceColor">#FF000000</Color>
            <Color x:Key="IslandSurfaceScrimColor">#E6000000</Color>
            <Color x:Key="CardBackgroundColor">#1AFFFFFF</Color>
            <Color x:Key="CardBorderColor">#26FFFFFF</Color>
            <Color x:Key="CardBorderStrongColor">#2EFFFFFF</Color>
            <Color x:Key="DividerColor">#24FFFFFF</Color>
            <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
            <Color x:Key="TextSecondaryColor">#B3FFFFFF</Color>
            <Color x:Key="TextTertiaryColor">#8CFFFFFF</Color>
            <Color x:Key="SubtleHoverColor">#26FFFFFF</Color>
            <Color x:Key="SubtlePressedColor">#33FFFFFF</Color>
            <Color x:Key="SubtleBorderHoverColor">#4DFFFFFF</Color>
            <Color x:Key="SubtleBorderPressedColor">#4DFFFFFF</Color>
            <Color x:Key="FocusStrokeColor">#FFFFFFFF</Color>
            <Color x:Key="AccentColor">#0A84FF</Color>
            <Color x:Key="AccentTextColor">#7AB8FF</Color>
            <Color x:Key="SecondaryAccentColor">#BF5AF2</Color>
            <Color x:Key="SecondaryAccentTextColor">#D3A6FF</Color>
            <Color x:Key="SuccessColor">#30D158</Color>
            <Color x:Key="WarningColor">#FF9F0A</Color>
            <Color x:Key="WarningTextColor">#FFC46B</Color>
            <Color x:Key="CriticalColor">#FF453A</Color>
            <Color x:Key="CriticalTextColor">#FF9A93</Color>
            <Color x:Key="CriticalStrokeColor">#FF7A72</Color>
            <Color x:Key="MetricNetworkTintColor">#7CC0FF</Color>

            <!--
                覆盖 WinUI 的标准资源键（Phase 2 第一块）：
                  * ControlCornerRadius —— 所有控件默认圆角统一到 8px（8px 网格）；
                  * FocusVisual* —— 键盘焦点视觉统一（无障碍要求：焦点必须清晰可见），
                    依据 [WinUI 资源键 / Fluent 焦点视觉规范]，主描边用 TextPrimary、次描边低对比。
            -->
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <Thickness x:Key="FocusVisualMargin">2</Thickness>
            <Thickness x:Key="FocusVisualPrimaryThickness">2</Thickness>
            <Thickness x:Key="FocusVisualSecondaryThickness">1</Thickness>
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{ThemeResource FocusStrokeColor}" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#40000000" />
        </ResourceDictionary>

        <!-- ==================== Light ==================== -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="IslandSurfaceColor">#FFF2F2F7</Color>
            <Color x:Key="IslandSurfaceScrimColor">#E6FFFFFF</Color>
            <Color x:Key="CardBackgroundColor">#0F000000</Color>
            <Color x:Key="CardBorderColor">#1F000000</Color>
            <Color x:Key="CardBorderStrongColor">#24000000</Color>
            <Color x:Key="DividerColor">#1F000000</Color>
            <Color x:Key="TextPrimaryColor">#FF000000</Color>
            <Color x:Key="TextSecondaryColor">#99000000</Color>
            <Color x:Key="TextTertiaryColor">#66000000</Color>
            <Color x:Key="SubtleHoverColor">#14000000</Color>
            <Color x:Key="SubtlePressedColor">#1F000000</Color>
            <Color x:Key="SubtleBorderHoverColor">#33000000</Color>
            <Color x:Key="SubtleBorderPressedColor">#33000000</Color>
            <Color x:Key="FocusStrokeColor">#FF000000</Color>
            <Color x:Key="AccentColor">#007AFF</Color>
            <Color x:Key="AccentTextColor">#0A66CC</Color>
            <Color x:Key="SecondaryAccentColor">#AF52DE</Color>
            <Color x:Key="SecondaryAccentTextColor">#7A3AA8</Color>
            <Color x:Key="SuccessColor">#248A3D</Color>
            <Color x:Key="WarningColor">#C93400</Color>
            <Color x:Key="WarningTextColor">#A62A00</Color>
            <Color x:Key="CriticalColor">#D70015</Color>
            <Color x:Key="CriticalTextColor">#B00012</Color>
            <Color x:Key="CriticalStrokeColor">#C40018</Color>
            <Color x:Key="MetricNetworkTintColor">#0A66CC</Color>
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <Thickness x:Key="FocusVisualMargin">2</Thickness>
            <Thickness x:Key="FocusVisualPrimaryThickness">2</Thickness>
            <Thickness x:Key="FocusVisualSecondaryThickness">1</Thickness>
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{ThemeResource FocusStrokeColor}" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#40000000" />
        </ResourceDictionary>

        <!-- ==================== HighContrast（交给系统色，保证可读） ==================== -->
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="IslandSurfaceColor">#FF000000</Color>
            <Color x:Key="IslandSurfaceScrimColor">#FF000000</Color>
            <Color x:Key="CardBackgroundColor">#FF000000</Color>
            <Color x:Key="CardBorderColor">#FFFFFFFF</Color>
            <Color x:Key="CardBorderStrongColor">#FFFFFFFF</Color>
            <Color x:Key="DividerColor">#FFFFFFFF</Color>
            <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
            <Color x:Key="TextSecondaryColor">#FFFFFFFF</Color>
            <Color x:Key="TextTertiaryColor">#FFFFFFFF</Color>
            <Color x:Key="SubtleHoverColor">#FF1F1F1F</Color>
            <Color x:Key="SubtlePressedColor">#FF3F3F3F</Color>
            <Color x:Key="SubtleBorderHoverColor">#FFFFFFFF</Color>
            <Color x:Key="SubtleBorderPressedColor">#FFFFFFFF</Color>
            <Color x:Key="FocusStrokeColor">#FFFFFFFF</Color>
            <Color x:Key="AccentColor">#FF00A2FF</Color>
            <Color x:Key="AccentTextColor">#FF00A2FF</Color>
            <Color x:Key="SecondaryAccentColor">#FFFF00FF</Color>
            <Color x:Key="SecondaryAccentTextColor">#FFFF00FF</Color>
            <Color x:Key="SuccessColor">#FF00FF00</Color>
            <Color x:Key="WarningColor">#FFFFFF00</Color>
            <Color x:Key="WarningTextColor">#FFFFFF00</Color>
            <Color x:Key="CriticalColor">#FFFF0000</Color>
            <Color x:Key="CriticalTextColor">#FFFF0000</Color>
            <Color x:Key="CriticalStrokeColor">#FFFF0000</Color>
            <Color x:Key="MetricNetworkTintColor">#FF00A2FF</Color>
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <Thickness x:Key="FocusVisualMargin">2</Thickness>
            <Thickness x:Key="FocusVisualPrimaryThickness">2</Thickness>
            <Thickness x:Key="FocusVisualSecondaryThickness">1</Thickness>
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{ThemeResource FocusStrokeColor}" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#FF000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ==================== 核心画刷（外层，key 全局唯一） ==================== -->
    <SolidColorBrush x:Key="IslandSurfaceBrush" Color="{ThemeResource IslandSurfaceColor}" />
    <SolidColorBrush x:Key="IslandSurfaceScrimBrush" Color="{ThemeResource IslandSurfaceScrimColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{ThemeResource CardBorderColor}" />
    <SolidColorBrush x:Key="CardBorderStrongBrush" Color="{ThemeResource CardBorderStrongColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource DividerColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="{ThemeResource SubtleHoverColor}" />
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="{ThemeResource SubtlePressedColor}" />
    <SolidColorBrush x:Key="SubtleBorderHoverBrush" Color="{ThemeResource SubtleBorderHoverColor}" />
    <SolidColorBrush x:Key="SubtleBorderPressedBrush" Color="{ThemeResource SubtleBorderPressedColor}" />
    <SolidColorBrush x:Key="FocusStrokeBrush" Color="{ThemeResource FocusStrokeColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{ThemeResource AccentTextColor}" />
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{ThemeResource SecondaryAccentColor}" />
    <SolidColorBrush x:Key="SecondaryAccentTextBrush" Color="{ThemeResource SecondaryAccentTextColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource WarningColor}" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="{ThemeResource WarningTextColor}" />
    <SolidColorBrush x:Key="CriticalBrush" Color="{ThemeResource CriticalColor}" />
    <SolidColorBrush x:Key="CriticalTextBrush" Color="{ThemeResource CriticalTextColor}" />
    <SolidColorBrush x:Key="CriticalStrokeBrush" Color="{ThemeResource CriticalStrokeColor}" />
    <SolidColorBrush x:Key="MetricNetworkTintBrush" Color="{ThemeResource MetricNetworkTintColor}" />

    <!-- ==================== 强调色状态层（值 = 迁移前的硬编码值，观感不变） ==================== -->
    <SolidColorBrush x:Key="AccentTintWeakBrush" Color="#2E0A84FF" />
    <SolidColorBrush x:Key="AccentTintSoftBrush" Color="#400A84FF" />
    <SolidColorBrush x:Key="AccentTintMediumBrush" Color="#520A84FF" />
    <SolidColorBrush x:Key="AccentTintStrongBrush" Color="#660A84FF" />
    <SolidColorBrush x:Key="AccentTintHeavyBrush" Color="#800A84FF" />
    <SolidColorBrush x:Key="AccentTintMaxBrush" Color="#990A84FF" />
    <SolidColorBrush x:Key="AccentForegroundHoverBrush" Color="#FFA8D2FF" />
    <SolidColorBrush x:Key="AccentForegroundPressedBrush" Color="#FFCBE4FF" />
    <SolidColorBrush x:Key="WarningTintWeakBrush" Color="#2EFF9F0A" />
    <SolidColorBrush x:Key="WarningTintSoftBrush" Color="#40FF9F0A" />
    <SolidColorBrush x:Key="WarningTintMediumBrush" Color="#52FF9F0A" />
    <SolidColorBrush x:Key="WarningTintStrongBrush" Color="#66FF9F0A" />
    <SolidColorBrush x:Key="WarningTintHeavyBrush" Color="#80FF9F0A" />
    <SolidColorBrush x:Key="WarningTintMaxBrush" Color="#99FF9F0A" />
    <SolidColorBrush x:Key="WarningForegroundHoverBrush" Color="#FFFFD79A" />
    <SolidColorBrush x:Key="WarningForegroundPressedBrush" Color="#FFFFE7C2" />
    <SolidColorBrush x:Key="SecondaryAccentTintWeakBrush" Color="#2EBF5AF2" />
    <SolidColorBrush x:Key="SecondaryAccentTintSoftBrush" Color="#40BF5AF2" />
    <SolidColorBrush x:Key="SecondaryAccentTintMediumBrush" Color="#52BF5AF2" />
    <SolidColorBrush x:Key="SecondaryAccentTintStrongBrush" Color="#66BF5AF2" />
    <SolidColorBrush x:Key="SecondaryAccentTintHeavyBrush" Color="#80BF5AF2" />
    <SolidColorBrush x:Key="SecondaryAccentTintMaxBrush" Color="#99BF5AF2" />
    <SolidColorBrush x:Key="SecondaryAccentForegroundHoverBrush" Color="#FFDDBBFF" />
    <SolidColorBrush x:Key="SecondaryAccentForegroundPressedBrush" Color="#FFEEDAFF" />
    <SolidColorBrush x:Key="CriticalTintWeakBrush" Color="#2EFF453A" />
    <SolidColorBrush x:Key="CriticalTintSoftBrush" Color="#40FF453A" />
    <SolidColorBrush x:Key="CriticalTintMediumBrush" Color="#52FF453A" />
    <SolidColorBrush x:Key="CriticalTintStrongBrush" Color="#66FF453A" />
    <SolidColorBrush x:Key="CriticalTintHeavyBrush" Color="#80FF453A" />
    <SolidColorBrush x:Key="CriticalTintMaxBrush" Color="#99FF453A" />
    <SolidColorBrush x:Key="CriticalForegroundHoverBrush" Color="#FF9A93" />
    <SolidColorBrush x:Key="CriticalForegroundPressedBrush" Color="#FFFFC2BD" />

    <!-- ==================== 圆角（8px 网格；胶囊取高度一半） ==================== -->
    <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusStandard">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="CornerRadiusPill">20</CornerRadius>
    <CornerRadius x:Key="CornerRadiusCapsule">999</CornerRadius>

    <!-- ==================== 间距（8px 基准 + 4px 半格） ==================== -->
    <x:Double x:Key="SpacingGridUnit">8</x:Double>
    <x:Double x:Key="SpacingXSmall">4</x:Double>
    <x:Double x:Key="SpacingSmall">8</x:Double>
    <x:Double x:Key="SpacingMedium">12</x:Double>
    <x:Double x:Key="SpacingLarge">16</x:Double>
    <x:Double x:Key="SpacingXLarge">24</x:Double>
    <Thickness x:Key="SpacingInsetSmall">8,4,8,4</Thickness>
    <Thickness x:Key="SpacingInsetMedium">16,8,16,8</Thickness>
    <Thickness x:Key="SpacingInsetCard">16</Thickness>

    <!-- ==================== 字体层级（Fluent 2 type ramp） ==================== -->
    <x:Double x:Key="TypeCaptionSize">12</x:Double>
    <x:Double x:Key="TypeCaptionLineHeight">16</x:Double>
    <x:Double x:Key="TypeBodySize">14</x:Double>
    <x:Double x:Key="TypeBodyLineHeight">20</x:Double>
    <x:Double x:Key="TypeSubtitleSize">20</x:Double>
    <x:Double x:Key="TypeSubtitleLineHeight">28</x:Double>
    <x:Double x:Key="TypeTitleSize">28</x:Double>
    <x:Double x:Key="TypeTitleLineHeight">36</x:Double>
    <FontWeight x:Key="TypeRegularWeight">Normal</FontWeight>
    <FontWeight x:Key="TypeStrongWeight">SemiBold</FontWeight>

    <!-- ==================== 图标尺寸（与 8px 网格对齐） ==================== -->
    <x:Double x:Key="IconSizeSmall">16</x:Double>
    <x:Double x:Key="IconSizeStandard">20</x:Double>
    <x:Double x:Key="IconSizeLarge">24</x:Double>
    <x:Double x:Key="IconStrokeThickness">1.8</x:Double>

    <!-- ==================== 动效：三档时长 + 弹簧物理参数 + 统一缓动 ==================== -->
    <x:Double x:Key="DurationFastMs">150</x:Double>
    <x:Double x:Key="DurationNormalMs">300</x:Double>
    <x:Double x:Key="DurationSlowMs">500</x:Double>
    <x:Double x:Key="DurationFastSeconds">0.15</x:Double>
    <x:Double x:Key="DurationNormalSeconds">0.3</x:Double>
    <x:Double x:Key="DurationSlowSeconds">0.5</x:Double>
    <x:Double x:Key="SpringPeriodExpandSeconds">0.42</x:Double>
    <x:Double x:Key="SpringPeriodCollapseSeconds">0.22</x:Double>
    <x:Double x:Key="SpringDampingExpand">0.62</x:Double>
    <x:Double x:Key="SpringDampingCollapse">0.9</x:Double>
    <CubicEase x:Key="EasingDecelerate" EasingMode="EaseOut" />
    <CubicEase x:Key="EasingStandard" EasingMode="EaseInOut" />

    <!--
        强调色状态层的 Color 版本（外层，key 唯一）。
        存在的理由：`DashboardIslandControl.xaml` 里各按钮的 UserControl.Resources 需要**覆盖系统主题资源**
        （ButtonBackgroundPointerOver 等），那些 Setter 要的是 Color 而不是 Brush，所以两套都要有。
    -->
    <Color x:Key="AccentTintSoftColor">#400A84FF</Color>
    <Color x:Key="AccentTintMediumColor">#520A84FF</Color>
    <Color x:Key="AccentTintHeavyColor">#800A84FF</Color>
    <Color x:Key="AccentTintMaxColor">#990A84FF</Color>
    <Color x:Key="AccentForegroundHoverColor">#FFA8D2FF</Color>
    <Color x:Key="AccentForegroundPressedColor">#FFCBE4FF</Color>
    <Color x:Key="WarningTintSoftColor">#40FF9F0A</Color>
    <Color x:Key="WarningTintMediumColor">#52FF9F0A</Color>
    <Color x:Key="WarningTintHeavyColor">#80FF9F0A</Color>
    <Color x:Key="WarningTintMaxColor">#99FF9F0A</Color>
    <Color x:Key="WarningForegroundHoverColor">#FFFFD79A</Color>
    <Color x:Key="WarningForegroundPressedColor">#FFFFE7C2</Color>
    <Color x:Key="SecondaryAccentTintSoftColor">#40BF5AF2</Color>
    <Color x:Key="SecondaryAccentTintMediumColor">#52BF5AF2</Color>
    <Color x:Key="SecondaryAccentTintHeavyColor">#80BF5AF2</Color>
    <Color x:Key="SecondaryAccentTintMaxColor">#99BF5AF2</Color>
    <Color x:Key="SecondaryAccentForegroundHoverColor">#FFDDBBFF</Color>
    <Color x:Key="SecondaryAccentForegroundPressedColor">#FFEEDAFF</Color>
    <Color x:Key="CriticalTintSoftColor">#40FF453A</Color>
    <Color x:Key="CriticalTintMediumColor">#52FF453A</Color>
    <Color x:Key="CriticalTintHeavyColor">#80FF453A</Color>
    <Color x:Key="CriticalTintMaxColor">#99FF453A</Color>
    <Color x:Key="CriticalForegroundPressedColor">#FFFFC2BD</Color>
</ResourceDictionary>
