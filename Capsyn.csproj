<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Capsyn —— Windows「灵动岛」。
    Windows App SDK / WinUI 3，C#，Unpackaged（未打包）：
      * WindowsPackageType=None → 不需要 MSIX 打包、不需要签名，直接跑 exe。
      * 生成的 WindowsAppSdkBootstrapInitialize 会自动引导本机已安装的 Windows App Runtime。
      * EnableMsixTooling=false → .xbf 以散文件形式拷到 build 输出（未打包应用直接读磁盘上的 .xbf）。
        代价：dotnet publish 不会自动带上这些 .xbf 和 Capsyn.pri，所以文件末尾有个补拷 target。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Capsyn</RootNamespace>
    <AssemblyName>Capsyn</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- WinAppSDK 的原生依赖是分架构的，这里固定本机 x64。 -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- WinUI/WinAppSDK 会给 RuntimeIdentifiers 注入 win-x86;win-x64;win-arm64。
         本机只跑 x64，这里显式收窄，免得 restore 去要另外两个架构的包。 -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- .NET 运行时用系统已装的框架依赖版本（本机已安装 .NET 9 桌面运行时）。 -->
    <SelfContained>false</SelfContained>
    <!--
      离线构建的关键开关：框架依赖（SelfContained=false）的构建不需要 RID 专用「运行时包」，
      但 .NET SDK 默认会把它们写进 restore 的下载依赖：
        Microsoft.NETCore.App.Runtime.win-*
        Microsoft.WindowsDesktop.App.Runtime.win-*   （FrameworkReference 里并没有它，属于「传递」下载）
        Microsoft.AspNetCore.App.Runtime.win-*       （同上）
      本机缓存里没有这些包 → Visual Studio（Framework MSBuild，把它们当 PackageReference）
      会报一片 NU1100；dotnet CLI（Core MSBuild，当 PackageDownload）只是记成警告。
      关掉下载后只用本机已安装的 targeting pack / apphost pack，CLI 和 VS 都不会再报错。

      但**自包含发布**（publish 时带 -p:SelfContained=true）恰恰必须要这些 RID 运行时包，
      无条件关掉会报 NETSDK1185「运行时包不可用」。所以这两个开关只在非自包含时生效：
        dotnet build ...                         → 开关生效（NU1100 修复保留）
        dotnet publish -p:SelfContained=true ... → 自动放开，正常下载运行时包
    -->
    <EnableRuntimePackDownload Condition="'$(SelfContained)' != 'true'">false</EnableRuntimePackDownload>
    <DisableTransitiveFrameworkReferenceDownloads Condition="'$(SelfContained)' != 'true'">true</DisableTransitiveFrameworkReferenceDownloads>
    <!-- Windows App Runtime 1.8 已安装在本机，所以不需要自带 WinAppSDK 运行时。
         要发给没装运行时的机器（或发自包含安装包）时，发布时加
         -p:WindowsAppSDKSelfContained=true 即可。 -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>

    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250916003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <!--
    打包用：publish 之后把 XAML 编译产物补进发布目录。
    未打包应用加载 XAML 靠两样东西：每个 .xaml 对应的 .xbf，以及 MRT Core 生成的 Capsyn.pri。
    但 dotnet publish 只收集「build 产物清单」里的文件，而 .xbf / .pri 是 XAML 编译器用 target
    拷出来的、不在清单里 —— 所以 publish 出来的目录缺它们，双击起不来（dotnet build 却完全正常，
    很难发现）。这里只**补拷**，不改 build 行为。
    发布完请确认 publish\ 里有 App.xbf、MainWindow.xbf、Controls\*.xbf 和 Capsyn.pri。
  -->
  <Target Name="CopyXamlArtifactsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_XamlPublishArtifact Include="$(TargetDir)**\*.xbf" />
      <_XamlPublishArtifact
        Include="$(TargetDir)$(AssemblyName).pri"
        Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_XamlPublishArtifact)"
      DestinationFiles="@(_XamlPublishArtifact->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
