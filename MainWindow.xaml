<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Capsyn.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Capsyn.Controls">

    <!--
        窗口本体完全透明（Background="Transparent"），
        可见的只有 TimeIslandControl 里的黑色胶囊 —— 配合窗口的 DWM 帧扩展实现圆角外透明。

        TODO(扩展): 展开态/通知/音乐卡片的布局都挂在这个 Grid 里，
                    用 VisualState 或 Storyboard 在「胶囊态 / 展开态」之间切换。
    -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <controls:TimeIslandControl x:Name="TimeIsland" />
    </Grid>
</Window>
