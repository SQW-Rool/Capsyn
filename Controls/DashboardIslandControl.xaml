<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Capsyn.Controls.DashboardIslandControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 卡片：半透明白底 + 细描边，压在看板的纯黑底上 -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#8CFFFFFF" />
        </Style>

        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontFamily" Value="Cascadia Code" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>

        <Style x:Key="BarTrack" TargetType="Border">
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <Style x:Key="BarFill" TargetType="Border">
            <Setter Property="Background" Value="#FF7CC0FF" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <!--
        看板岛：550 × 350（尺寸由 IslandShell 按 IslandOptions 设置，这里靠 Stretch 铺满）。
        布局：
          第 1 行  CPU / 内存 / 网络上下行 三张卡
          第 2 行  一条横线
          第 3 行  电源按钮（图标 + 文字），其余空间留白给后续模块

        TODO(扩展): 第 3 行右侧、下方整块空白留给通知列表 / 音乐卡片 / 计时器。
    -->
    <Grid Padding="16" Background="{x:Null}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 第 1 行：三张数据卡 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 处理器 -->
            <Border
                x:Name="CardCpu"
                Grid.Column="0"
                Height="104"
                Style="{StaticResource CardBorder}">
                <StackPanel VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="处理器" Style="{StaticResource CardLabel}" />
                    <TextBlock Text="{x:Bind ViewModel.CpuText, Mode=OneWay}" Style="{StaticResource CardValue}" />
                    <Grid Height="6">
                        <Border Style="{StaticResource BarTrack}" />
                        <Border Style="{StaticResource BarFill}" Width="{x:Bind ViewModel.CpuBarWidth, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 内存 -->
            <Border
                x:Name="CardMemory"
                Grid.Column="1"
                Height="104"
                Style="{StaticResource CardBorder}">
                <StackPanel VerticalAlignment="Center" Spacing="8">
                    <Grid>
                        <TextBlock Text="内存" Style="{StaticResource CardLabel}" HorizontalAlignment="Left" />
                        <TextBlock Text="{x:Bind ViewModel.MemoryPercentText, Mode=OneWay}" Style="{StaticResource CardLabel}" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock
                        Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}"
                        Style="{StaticResource CardValue}"
                        FontSize="16" />
                    <Grid Height="6">
                        <Border Style="{StaticResource BarTrack}" />
                        <Border Style="{StaticResource BarFill}" Width="{x:Bind ViewModel.MemoryBarWidth, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 网络上下行 -->
            <Border
                x:Name="CardNetwork"
                Grid.Column="2"
                Height="104"
                Style="{StaticResource CardBorder}">
                <StackPanel VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="网络" Style="{StaticResource CardLabel}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.NetworkDownText, Mode=OneWay}"
                        Style="{StaticResource CardValue}"
                        FontSize="15" />
                    <TextBlock
                        Text="{x:Bind ViewModel.NetworkUpText, Mode=OneWay}"
                        Style="{StaticResource CardValue}"
                        FontSize="15" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 第 2 行：横线 -->
        <Border
            Grid.Row="1"
            Height="1"
            Margin="0,14,0,0"
            Background="#24FFFFFF"
            HorizontalAlignment="Stretch" />

        <!-- 第 3 行：电源按钮（矢量图标 + 文字） -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Margin="0,16,0,0"
            VerticalAlignment="Top">
            <Button
                x:Name="PowerButton"
                Click="OnPowerClick"
                Padding="16,9"
                CornerRadius="12"
                Background="#1AFFFFFF"
                BorderBrush="#2EFFFFFF"
                BorderThickness="1">

                <!-- 把默认按钮态刷成半透明白，免得在纯黑底上出现浅色主题的灰块 -->
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#4DFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#4DFFFFFF" />
                </Button.Resources>

                <StackPanel Orientation="Horizontal" Spacing="9">
                    <!-- 电源图标：矢量路径（圆环缺口 + 竖杠），不依赖任何图标字体 -->
                    <Path
                        Width="18"
                        Height="18"
                        Stretch="Uniform"
                        Stroke="#FFFFFFFF"
                        StrokeThickness="1.8"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        Data="M 12,3 L 12,11 M 16,6.07 A 8,8 0 1 1 8,6.07" />
                    <TextBlock
                        Text="电源"
                        FontSize="14"
                        Foreground="#FFFFFFFF"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
