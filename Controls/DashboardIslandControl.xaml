<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Capsyn.Controls.DashboardIslandControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">



    <!--
        看板岛：550 × 350（尺寸由 IslandShell 按 IslandOptions 设置，这里靠 Stretch 铺满）。
        里面有两个视图，只切可见性（面板尺寸、窗口区域、动画都不用变）：

          视图 1（默认，指标）：第 1 行三张卡（CPU / 内存 / 网络上下行）+ 横线 +
                                左下「时间工具」按钮（时钟图标 + 文字）+ 右下角「设置」「关闭程序」两个圆形图标按钮
          视图 2（时间工具）：左上角「返回」圆形图标按钮 + 横线 +
                              「正计时 / 倒计时 / 闹钟」三个按钮（三列等宽、垂直居中）+
                              右下角两个圆形图标按钮

        两个视图之间走一段 iOS 风格的 push / pop 过场（旧视图往一侧滑出、新视图从另一侧滑入，
        返回时方向相反），见 SetTimeToolsVisible()。

        两个视图都还没接功能（按需求先只做 UI）。

        TODO(扩展): 通知列表 / 音乐卡片往留白区放。
        TODO(扩展): 设置面板接在 SettingsButton 上（加 Click → 弹窗或展开一块面板）。
        TODO(扩展): 正计时 / 倒计时 / 闹钟接各自的计时逻辑 + 时间岛上的显示。
    -->
    <Grid Padding="16" Background="{x:Null}">
        <Grid.RowDefinitions>
            <!--
                第 1 行固定 104（= 指标卡高度）：两个视图共用这一行，必须固定住 ——
                否则过场期间旧视图还占着高度、收起来之后下面两行会整体跳一下。
            -->
            <RowDefinition Height="104" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 视图 1：指标 ==================== -->

        <!-- 第 1 行：三张数据卡 -->
        <Grid x:Name="MetricsView" Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 处理器 -->
            <Border
                x:Name="CardCpu"
                Grid.Column="0"
                Height="104"
                Style="{StaticResource CardBorder}">
                <StackPanel VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="处理器" Style="{StaticResource CardLabel}" />
                    <TextBlock Text="{x:Bind ViewModel.CpuText, Mode=OneWay}" Style="{StaticResource CardValue}" />
                    <Grid Height="6">
                        <Border Style="{StaticResource BarTrack}" />
                        <Border Style="{StaticResource BarFill}" Width="{x:Bind ViewModel.CpuBarWidth, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 内存 -->
            <Border
                x:Name="CardMemory"
                Grid.Column="1"
                Height="104"
                Style="{StaticResource CardBorder}">
                <StackPanel VerticalAlignment="Center" Spacing="8">
                    <Grid>
                        <TextBlock Text="内存" Style="{StaticResource CardLabel}" HorizontalAlignment="Left" />
                        <TextBlock Text="{x:Bind ViewModel.MemoryPercentText, Mode=OneWay}" Style="{StaticResource CardLabel}" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock
                        Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}"
                        Style="{StaticResource CardValue}"
                        FontSize="{ThemeResource TypeBodySize}" />
                    <Grid Height="6">
                        <Border Style="{StaticResource BarTrack}" />
                        <Border Style="{StaticResource BarFill}" Width="{x:Bind ViewModel.MemoryBarWidth, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 网络上下行 -->
            <Border
                x:Name="CardNetwork"
                Grid.Column="2"
                Height="104"
                Style="{StaticResource CardBorder}">
                <StackPanel VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="网络" Style="{StaticResource CardLabel}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.NetworkDownText, Mode=OneWay}"
                        Style="{StaticResource CardValue}"
                        FontSize="{ThemeResource TypeBodySize}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.NetworkUpText, Mode=OneWay}"
                        Style="{StaticResource CardValue}"
                        FontSize="{ThemeResource TypeBodySize}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 第 3 行左上：「时间工具」（视图 1 才有） -->
        <Button
            x:Name="TimeToolsButton"
            Grid.Row="2"
            Margin="0,16,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource ToolButton}"
            Click="OnTimeToolsClick">

            <StackPanel Orientation="Horizontal" Spacing="9">
                <!-- 时钟图标：矢量路径（圆环 + 两根指针），不依赖任何图标字体 -->
                <Path
                    Width="{ThemeResource IconSizeStandard}"
                    Height="{ThemeResource IconSizeStandard}"
                    Stretch="Uniform"
                    Stroke="{ThemeResource TextPrimaryBrush}"
                    StrokeThickness="{ThemeResource IconStrokeThickness}"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    Data="M 12,3 A 9,9 0 1 1 11.99,3 M 12,12 L 12,6.5 M 12,12 L 16.5,14.5" />
                <TextBlock
                    Text="时间工具"
                    FontSize="{ThemeResource TypeBodySize}"
                    Foreground="{ThemeResource TextPrimaryBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- ==================== 视图 2：时间工具 ==================== -->

        <!-- 左上角：返回（点击回到指标视图） -->
        <Button
            x:Name="TimeToolsBackButton"
            Grid.Row="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="Collapsed"
            Style="{StaticResource IconButton}"
            Click="OnTimeToolsBackClick">

            <!-- 左箭头：矢量路径 -->
            <Path
                Width="{ThemeResource IconSizeStandard}"
                Height="{ThemeResource IconSizeStandard}"
                Stretch="Uniform"
                Stroke="{ThemeResource TextPrimaryBrush}"
                StrokeThickness="{ThemeResource IconStrokeThickness}"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                Data="M 11,5 L 3,12 L 11,19 M 3,12 L 21,12" />
        </Button>

        <!-- 三个工具按钮（先只做 UI，都不接 Click）；靠上排，距横线 8px -->
        <Grid
            x:Name="TimeToolsPanel"
            Grid.Row="2"
            ColumnSpacing="12"
            Margin="0,8,0,0"
            VerticalAlignment="Top"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 正计时：蓝 -->
            <Button
                x:Name="StopwatchButton"
                Grid.Column="0"
                Height="56"
                Content="正计时"
                Style="{StaticResource StopwatchToolStyle}">

                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource AccentTintSoftColor}" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource AccentTintMediumColor}" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource AccentTintHeavyColor}" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource AccentTintMaxColor}" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource AccentForegroundHoverColor}" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource AccentForegroundPressedColor}" />
                </Button.Resources>
            </Button>

            <!-- 倒计时：橙 -->
            <Button
                x:Name="CountdownButton"
                Grid.Column="1"
                Height="56"
                Content="倒计时"
                Style="{StaticResource CountdownToolStyle}">

                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource WarningTintSoftColor}" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource WarningTintMediumColor}" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource WarningTintHeavyColor}" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource WarningTintMaxColor}" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource WarningForegroundHoverColor}" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource WarningForegroundPressedColor}" />
                </Button.Resources>
            </Button>

            <!-- 闹钟：紫 -->
            <Button
                x:Name="AlarmButton"
                Grid.Column="2"
                Height="56"
                Content="闹钟"
                Style="{StaticResource AlarmToolStyle}">

                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SecondaryAccentTintSoftColor}" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SecondaryAccentTintMediumColor}" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource SecondaryAccentTintHeavyColor}" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource SecondaryAccentTintMaxColor}" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource SecondaryAccentForegroundHoverColor}" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource SecondaryAccentForegroundPressedColor}" />
                </Button.Resources>
            </Button>
        </Grid>

        <!-- ==================== 两个视图共用 ==================== -->

        <!-- 第 2 行：横线 -->
        <Border
            Grid.Row="1"
            Height="1"
            Margin="0,14,0,0"
            Background="{ThemeResource DividerBrush}"
            HorizontalAlignment="Stretch" />

        <!-- 第 3 行右下角：「设置」「关闭程序」两个圆形图标按钮 -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="12"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom">

            <!-- 设置：按需求目前只有 UI —— 不接 Click，点击不触发任何动作 -->
            <Button
                x:Name="SettingsButton"
                Style="{StaticResource IconButton}">

                <!--
                    设置图标：矢量路径（圆环 + 8 个齿），不依赖任何图标字体。
                    齿尖到齿尖正好 18×18，整体缩放 1:1，笔画粗细 1.8。
                -->
                <Path
                    Width="{ThemeResource IconSizeStandard}"
                    Height="{ThemeResource IconSizeStandard}"
                    Stretch="Uniform"
                    Stroke="{ThemeResource TextPrimaryBrush}"
                    StrokeThickness="{ThemeResource IconStrokeThickness}"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    Data="M 12,6.8 A 5.2,5.2 0 1 1 12,17.2 A 5.2,5.2 0 1 1 12,6.8 M 17.2,12 L 21,12 M 15.68,15.68 L 18.36,18.36 M 12,17.2 L 12,21 M 8.32,15.68 L 5.64,18.36 M 6.8,12 L 3,12 M 8.32,8.32 L 5.64,5.64 M 12,6.8 L 12,3 M 15.68,8.32 L 18.36,5.64" />
            </Button>

            <!-- 关闭程序：只有一个图标，真正退出应用（唯一入口） -->
            <Button
                x:Name="CloseButton"
                Style="{StaticResource CloseIconButton}"
                Click="OnCloseClick">

                <!-- 这个按钮的指针态也走红色系，悬停时不会变回白灰 -->
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource CriticalTintSoftColor}" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource CriticalTintMediumColor}" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource CriticalTintHeavyColor}" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource CriticalTintMaxColor}" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource CriticalTextColor}" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource CriticalForegroundPressedColor}" />
                </Button.Resources>

                <!-- 电源图标：矢量路径（圆环缺口 + 竖杠），不依赖任何图标字体 -->
                <Path
                    Width="{ThemeResource IconSizeStandard}"
                    Height="{ThemeResource IconSizeStandard}"
                    Stretch="Uniform"
                    Stroke="{ThemeResource CriticalStrokeBrush}"
                    StrokeThickness="{ThemeResource IconStrokeThickness}"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    Data="M 12,3 L 12,11 M 16,6.07 A 8,8 0 1 1 8,6.07" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
