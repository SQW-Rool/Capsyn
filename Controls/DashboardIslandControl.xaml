<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Capsyn.Controls.DashboardIslandControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 卡片：半透明白底 + 细描边，压在看板的纯黑底上 -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#8CFFFFFF" />
        </Style>

        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontFamily" Value="Cascadia Code" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>

        <Style x:Key="BarTrack" TargetType="Border">
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <Style x:Key="BarFill" TargetType="Border">
            <Setter Property="Background" Value="#FF7CC0FF" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- 第 3 行左上的「设置」按钮（目前只有 UI） -->
        <Style x:Key="RowActionButton" TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderBrush" Value="#2EFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>

        <!--
            右下角的「关闭程序」：只有图标，圆形红色系，是退出应用的唯一入口。
            （这套红色原来在电源岛里，电源岛删掉后搬到这里。）
        -->
        <Style x:Key="CloseIconButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="#2EFF453A" />
            <Setter Property="BorderBrush" Value="#66FF453A" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- 把默认按钮态刷成半透明白，免得在纯黑底上出现浅色主题的灰块 -->
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#B3FFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#4DFFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#4DFFFFFF" />
    </UserControl.Resources>

    <!--
        看板岛：550 × 350（尺寸由 IslandShell 按 IslandOptions 设置，这里靠 Stretch 铺满）。
        布局：
          第 1 行  CPU / 内存 / 网络上下行 三张卡
          第 2 行  一条横线
          第 3 行  左上「设置」按钮（只有 UI），右下角「关闭程序」图标按钮（真正退出）
          其余空间留白

        TODO(扩展): 通知列表 / 音乐卡片 / 计时器往下面的留白区放。
        TODO(扩展): 设置面板接在 SettingsButton 上（加 Click → 弹窗或展开一块面板）。
    -->
    <Grid Padding="16" Background="{x:Null}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 第 1 行：三张数据卡 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 处理器 -->
            <Border
                x:Name="CardCpu"
                Grid.Column="0"
                Height="104"
                Style="{StaticResource CardBorder}">
                <StackPanel VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="处理器" Style="{StaticResource CardLabel}" />
                    <TextBlock Text="{x:Bind ViewModel.CpuText, Mode=OneWay}" Style="{StaticResource CardValue}" />
                    <Grid Height="6">
                        <Border Style="{StaticResource BarTrack}" />
                        <Border Style="{StaticResource BarFill}" Width="{x:Bind ViewModel.CpuBarWidth, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 内存 -->
            <Border
                x:Name="CardMemory"
                Grid.Column="1"
                Height="104"
                Style="{StaticResource CardBorder}">
                <StackPanel VerticalAlignment="Center" Spacing="8">
                    <Grid>
                        <TextBlock Text="内存" Style="{StaticResource CardLabel}" HorizontalAlignment="Left" />
                        <TextBlock Text="{x:Bind ViewModel.MemoryPercentText, Mode=OneWay}" Style="{StaticResource CardLabel}" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock
                        Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}"
                        Style="{StaticResource CardValue}"
                        FontSize="16" />
                    <Grid Height="6">
                        <Border Style="{StaticResource BarTrack}" />
                        <Border Style="{StaticResource BarFill}" Width="{x:Bind ViewModel.MemoryBarWidth, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 网络上下行 -->
            <Border
                x:Name="CardNetwork"
                Grid.Column="2"
                Height="104"
                Style="{StaticResource CardBorder}">
                <StackPanel VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="网络" Style="{StaticResource CardLabel}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.NetworkDownText, Mode=OneWay}"
                        Style="{StaticResource CardValue}"
                        FontSize="15" />
                    <TextBlock
                        Text="{x:Bind ViewModel.NetworkUpText, Mode=OneWay}"
                        Style="{StaticResource CardValue}"
                        FontSize="15" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 第 2 行：横线 -->
        <Border
            Grid.Row="1"
            Height="1"
            Margin="0,14,0,0"
            Background="#24FFFFFF"
            HorizontalAlignment="Stretch" />

        <!-- 第 3 行左上：「设置」按钮（按需求目前只有 UI —— 不接 Click，点击不触发任何动作） -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="12"
            Margin="0,16,0,0"
            VerticalAlignment="Top">
            <Button
                x:Name="SettingsButton"
                Style="{StaticResource RowActionButton}">

                <StackPanel Orientation="Horizontal" Spacing="9">
                    <!--
                        设置图标：矢量路径（圆环 + 8 个齿），不依赖任何图标字体。
                        齿尖到齿尖正好 18×18，整体缩放 1:1，笔画粗细 1.8。
                    -->
                    <Path
                        Width="18"
                        Height="18"
                        Stretch="Uniform"
                        Stroke="#FFFFFFFF"
                        StrokeThickness="1.8"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        Data="M 12,6.8 A 5.2,5.2 0 1 1 12,17.2 A 5.2,5.2 0 1 1 12,6.8 M 17.2,12 L 21,12 M 15.68,15.68 L 18.36,18.36 M 12,17.2 L 12,21 M 8.32,15.68 L 5.64,18.36 M 6.8,12 L 3,12 M 8.32,8.32 L 5.64,5.64 M 12,6.8 L 12,3 M 15.68,8.32 L 18.36,5.64" />
                    <TextBlock
                        Text="设置"
                        FontSize="14"
                        Foreground="#FFFFFFFF"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- 右下角：「关闭程序」—— 只有一个图标，真正退出应用 -->
        <Button
            x:Name="CloseButton"
            Grid.Row="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Style="{StaticResource CloseIconButton}"
            Click="OnCloseClick">

            <!-- 这个按钮的指针态也走红色系，悬停时不会变回白灰 -->
            <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#40FF453A" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#52FF453A" />
                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#80FF453A" />
                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#99FF453A" />
                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFF9A93" />
                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFC2BD" />
            </Button.Resources>

            <!-- 电源图标：矢量路径（圆环缺口 + 竖杠），不依赖任何图标字体 -->
            <Path
                Width="18"
                Height="18"
                Stretch="Uniform"
                Stroke="#FFFF7A72"
                StrokeThickness="1.8"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                Data="M 12,3 L 12,11 M 16,6.07 A 8,8 0 1 1 8,6.07" />
        </Button>
    </Grid>
</UserControl>
