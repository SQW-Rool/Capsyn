<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Capsyn.Controls.MusicIslandControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        音乐副岛：看板右侧的独立小岛（340 宽，与看板等高）。
        两个视图：
          * 播放器：封面 / 歌名 / 歌手 / 进度 / 控制；头部右侧是「音源名 ▾」，点它切到音源选择；
          * 音源选择：内置播放器列表（本机没装的置灰），选中后只跟随该音源；没有音乐时也是这个视图。
    -->
    <Grid Padding="14">

        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 背景：专辑封面铺满 + 黑色渐变遮罩 -->
        <Grid x:Name="BackdropLayer" Grid.RowSpan="2" IsHitTestVisible="False">
            <Image x:Name="BackdropImage" Stretch="UniformToFill" Opacity="0.42" />
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B3000000" Offset="0" />
                        <GradientStop Color="#E6000000" Offset="0.6" />
                        <GradientStop Color="#FA000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- 头部：状态 + 均衡器｜音源按钮 / 返回 -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <TextBlock
                    x:Name="StateText"
                    Text="没有正在播放"
                    Style="{StaticResource HeroCaption}"
                    VerticalAlignment="Center" />

                <StackPanel
                    x:Name="Equalizer"
                    Orientation="Horizontal"
                    Spacing="2.5"
                    VerticalAlignment="Center"
                    Height="12"
                    Visibility="Collapsed">

                    <Rectangle x:Name="Eq1" Width="2.5" Height="12" RadiusX="1.25" RadiusY="1.25" Fill="{ThemeResource AccentTextBrush}" VerticalAlignment="Bottom" />
                    <Rectangle x:Name="Eq2" Width="2.5" Height="12" RadiusX="1.25" RadiusY="1.25" Fill="{ThemeResource AccentTextBrush}" VerticalAlignment="Bottom" />
                    <Rectangle x:Name="Eq3" Width="2.5" Height="12" RadiusX="1.25" RadiusY="1.25" Fill="{ThemeResource AccentTextBrush}" VerticalAlignment="Bottom" />
                </StackPanel>

                <!-- 播放冲突（仅提醒模式）：点一下暂停还在放的那个 -->
                <Button
                    x:Name="ConflictButton"
                    Style="{StaticResource GhostCaptionButton}"
                    Click="OnConflictPauseClick"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="ConflictPauseButton"
                    AutomationProperties.Name="暂停冲突的播放器">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Path
                            Width="10"
                            Height="10"
                            Stretch="Uniform"
                            VerticalAlignment="Center"
                            Stroke="{ThemeResource WarningTextBrush}"
                            StrokeThickness="1.6"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Data="M 12,4 L 22,20 L 2,20 Z M 12,10 V 14 M 12,17 V 17.2" />
                        <TextBlock
                            x:Name="ConflictText"
                            Text="暂停它"
                            FontSize="10.5"
                            Foreground="{ThemeResource WarningTextBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button
                    x:Name="SourceButton"
                    Style="{StaticResource GhostCaptionButton}"
                    Click="OnSourceButtonClick"
                    AutomationProperties.AutomationId="SourceButton"
                    AutomationProperties.Name="选择音源">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="SourceText"
                            Style="{StaticResource HeroCaption}"
                            TextTrimming="CharacterEllipsis"
                            MaxWidth="132"
                            VerticalAlignment="Center" />
                        <Path
                            Width="7"
                            Height="7"
                            Stretch="Uniform"
                            VerticalAlignment="Center"
                            Stroke="{ThemeResource TextTertiaryBrush}"
                            StrokeThickness="1.6"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Data="M 6,9 L 12,15 L 18,9" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="PickerBackButton"
                    Style="{StaticResource GhostCaptionButton}"
                    Click="OnPickerBackClick"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="PickerBackButton"
                    AutomationProperties.Name="返回播放器">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Path
                            Width="9"
                            Height="9"
                            Stretch="Uniform"
                            VerticalAlignment="Center"
                            Stroke="{ThemeResource TextSecondaryBrush}"
                            StrokeThickness="1.6"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Data="M 15,6 L 9,12 L 15,18" />
                        <TextBlock Text="返回" Style="{StaticResource HeroCaption}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 视图 1：播放器 -->
        <StackPanel
            x:Name="PlayerLayer"
            Grid.Row="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Stretch"
            Spacing="0">

            <!-- 封面 -->
            <Border
                x:Name="CoverFrame"
                Width="140"
                Height="140"
                HorizontalAlignment="Center"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardBorderStrongBrush}"
                Background="{ThemeResource CardBackgroundBrush}">

                <Grid>
                    <Image x:Name="CoverImage" Stretch="UniformToFill" Visibility="Collapsed" />
                    <Path
                        x:Name="CoverPlaceholder"
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        Stroke="{ThemeResource TextSecondaryBrush}"
                        StrokeThickness="1.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        Opacity="0.6"
                        Data="M 9.5,17.5 A 2.4,2.4 0 1 1 9.49,17.5 M 11.9,17.5 V 6.5 L 18,5 V 15 M 18,15 A 2.4,2.4 0 1 1 17.99,15" />
                </Grid>
            </Border>

            <!-- 歌名 -->
            <TextBlock
                x:Name="TitleText"
                Text="没有正在播放的媒体"
                FontSize="20"
                FontWeight="{ThemeResource TypeStrongWeight}"
                Foreground="{ThemeResource TextPrimaryBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis"
                MaxLines="1"
                MaxWidth="290"
                Margin="0,10,0,0" />

            <!-- 歌手 -->
            <TextBlock
                x:Name="ArtistText"
                Text="点右上角选音源"
                FontSize="13"
                Foreground="{ThemeResource TextSecondaryBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis"
                MaxLines="1"
                MaxWidth="286"
                Margin="0,3,0,0" />

            <!-- 进度 -->
            <ProgressBar
                x:Name="Progress"
                Minimum="0"
                Maximum="1"
                Value="0"
                Height="3"
                Width="240"
                Margin="0,10,0,0" />

            <Grid Width="240" Margin="0,3,0,0">
                <TextBlock x:Name="PositionText" Text="--:--" Style="{StaticResource HeroCaption}" FontSize="11.5" />
                <TextBlock x:Name="DurationText" Text="--:--" HorizontalAlignment="Right" Style="{StaticResource HeroCaption}" FontSize="11.5" />
            </Grid>

            <!-- 控制：上一首 / 播放暂停（主色大圆） / 下一首 -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="16"
                HorizontalAlignment="Center"
                Margin="0,8,0,0">

                <Button
                    x:Name="PreviousButton"
                    Style="{StaticResource IconButton}"
                    Width="40"
                    Height="40"
                    Click="OnPreviousClick"
                    IsEnabled="False">

                    <Path
                        Width="17"
                        Height="17"
                        Stretch="Uniform"
                        Stroke="{ThemeResource TextPrimaryBrush}"
                        StrokeThickness="{ThemeResource IconStrokeThickness}"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        Data="M 5,5 V 19 M 19,5 L 8,12 L 19,19 Z" />
                </Button>

                <Button
                    x:Name="PlayPauseButton"
                    Width="52"
                    Height="52"
                    CornerRadius="26"
                    BorderThickness="1"
                    Background="{ThemeResource AccentTintStrongBrush}"
                    BorderBrush="{ThemeResource AccentTintMaxBrush}"
                    Click="OnPlayPauseClick"
                    IsEnabled="False">

                    <Grid>
                        <Path
                            x:Name="PlayIcon"
                            Width="22"
                            Height="22"
                            Stretch="Uniform"
                            Fill="{ThemeResource AccentTextBrush}"
                            Data="M 7,4 L 20,12 L 7,20 Z" />

                        <Path
                            x:Name="PauseIcon"
                            Width="22"
                            Height="22"
                            Stretch="Uniform"
                            Fill="{ThemeResource AccentTextBrush}"
                            Visibility="Collapsed"
                            Data="M 6,4 H 10 V 20 H 6 Z M 14,4 H 18 V 20 H 14 Z" />
                    </Grid>
                </Button>

                <Button
                    x:Name="NextButton"
                    Style="{StaticResource IconButton}"
                    Width="40"
                    Height="40"
                    Click="OnNextClick"
                    IsEnabled="False">

                    <Path
                        Width="17"
                        Height="17"
                        Stretch="Uniform"
                        Stroke="{ThemeResource TextPrimaryBrush}"
                        StrokeThickness="{ThemeResource IconStrokeThickness}"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        Data="M 19,5 V 19 M 5,5 L 16,12 L 5,19 Z" />
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- 视图 2：音源选择 -->
        <Grid x:Name="PickerLayer" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="选一个音源：置灰的就是本机没装"
                Style="{StaticResource HeroCaption}"
                TextWrapping="Wrap"
                Margin="0,2,0,4" />

            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SourceList" Spacing="4" />
            </ScrollViewer>

            <TextBlock
                x:Name="PickerHint"
                Grid.Row="2"
                Text="选中后会切换；没在运行会尝试帮你启动"
                Style="{StaticResource HeroCaption}"
                Opacity="0.75"
                TextWrapping="Wrap"
                Margin="0,4,0,0" />
        </Grid>
    </Grid>
</UserControl>
