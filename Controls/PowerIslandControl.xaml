<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Capsyn.Controls.PowerIslandControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 把按钮指针态的主题资源就地改成半透明白，避免纯黑底上出现浅色主题的灰块 -->
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#B3FFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#4DFFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#4DFFFFFF" />

        <Style x:Key="PowerActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderBrush" Value="#2EFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="0,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- 「关闭程序」是唯一真正生效的动作，标红让它醒目一点（红底 + 红字） -->
        <Style x:Key="PowerActionDangerButton" TargetType="Button" BasedOn="{StaticResource PowerActionButton}">
            <Setter Property="Background" Value="#2EFF453A" />
            <Setter Property="BorderBrush" Value="#66FF453A" />
            <Setter Property="Foreground" Value="#FFFF7A72" />
        </Style>
    </UserControl.Resources>

    <!--
        电源岛：550 × 84，四个按钮平分一行。
        按需求「关机 / 重启 / 睡眠」只做 UI（点击不执行任何系统动作），只有「关闭程序」真正生效。
        尺寸由 IslandShell 按 IslandOptions 设置，这里靠 Stretch 铺满。

        TODO(扩展): 需要真做系统电源操作时，在对应 Click 里调系统 API，并先弹确认。
    -->
    <Grid Padding="16" Background="{x:Null}">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="ShutdownButton"
                Grid.Column="0"
                Content="关机"
                Style="{StaticResource PowerActionButton}"
                Click="OnShutdownClick" />
            <Button
                x:Name="RestartButton"
                Grid.Column="1"
                Content="重启"
                Style="{StaticResource PowerActionButton}"
                Click="OnRestartClick" />
            <Button
                x:Name="SleepButton"
                Grid.Column="2"
                Content="睡眠"
                Style="{StaticResource PowerActionButton}"
                Click="OnSleepClick" />
            <Button
                x:Name="ExitButton"
                Grid.Column="3"
                Content="关闭程序"
                Style="{StaticResource PowerActionDangerButton}"
                Click="OnExitClick">

                <!-- 这个按钮的指针态也走红色系，悬停时不会变回白灰 -->
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#40FF453A" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#52FF453A" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFF9A93" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFC2BD" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#80FF453A" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#99FF453A" />
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</UserControl>
