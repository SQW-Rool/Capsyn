<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Capsyn.Controls.TimerDotControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        「第二个计时」的独立小圆岛：40 × 40 的圆，里面一圈 2px 进度环 + 模式图标。
        它是一块**独立的窗口区域**（由 IslandShell 的 SetWindowRgn 并进轮廓），
        不是塞在胶囊里的子元素；底色来自整块纯黑底板，所以这里不用画背景。
        点一下 = 把这个计时换到主位（胶囊里）。
    -->
    <Button
        x:Name="DotButton"
        Width="40"
        Height="40"
        MinWidth="0"
        MinHeight="0"
        Padding="0"
        Background="Transparent"
        BorderThickness="0"
        CornerRadius="{ThemeResource CornerRadiusCapsule}"
        UseSystemFocusVisuals="False"
        Click="OnDotClick">

        <Grid Width="40" Height="40">
            <!-- 暗色轨道：让这个圆即使在进度很小时也读得出是"一个岛" -->
            <Ellipse
                Width="40"
                Height="40"
                Stroke="{ThemeResource SubtleHoverBrush}"
                StrokeThickness="2" />

            <!-- 进度环：Data 由代码按进度重算 -->
            <Path
                x:Name="Ring"
                Stroke="{ThemeResource AccentTextBrush}"
                StrokeThickness="2"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round" />

            <!-- 模式图标 -->
            <Path
                x:Name="StopwatchIcon"
                Width="14"
                Height="14"
                Stretch="Uniform"
                Stroke="{ThemeResource AccentTextBrush}"
                StrokeThickness="2"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="M 9,4 L 15,4 M 12,4 L 12,7.2 M 12,21 A 7.2,7.2 0 1 0 11.99,21 M 12,11.5 L 12,15.2 M 12,15.2 L 15,16.8" />

            <Path
                x:Name="CountdownIcon"
                Width="14"
                Height="14"
                Stretch="Uniform"
                Stroke="{ThemeResource WarningTextBrush}"
                StrokeThickness="2"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                Data="M 7,3.5 L 17,3.5 M 7,20.5 L 17,20.5 M 8,4.5 C 8,9.5 12,10.5 12,12 C 12,13.5 8,14.5 8,19.5 M 16,4.5 C 16,9.5 12,10.5 12,12 C 12,13.5 16,14.5 16,19.5" />
        </Grid>
    </Button>
</UserControl>
