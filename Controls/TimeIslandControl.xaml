<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Capsyn.Controls.TimeIslandControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        时间岛：只画 HH:mm:ss。
        黑色胶囊的形状由 IslandShell 的底板 + 窗口区域给出（胶囊以外不算窗口），所以这里不需要背景。

        TODO(扩展): 展开后这里可以再放状态图标（免打扰 / 计时中 / 正在播放）等。
    -->
    <Grid Background="{x:Null}">
        <TextBlock
            x:Name="TimeText"
            Text="{x:Bind ViewModel.CurrentTime, Mode=OneWay}"
            FontFamily="{x:Bind ViewModel.FontFamily}"
            FontSize="{x:Bind ViewModel.FontSize}"
            FontWeight="SemiBold"
            Foreground="{x:Bind ViewModel.ForegroundBrush}"
            IsTextScaleFactorEnabled="False"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextAlignment="Center" />
    </Grid>
</UserControl>
