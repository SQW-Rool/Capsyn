<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Capsyn.Controls.TimeIslandControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        时间岛（顶部胶囊），两种形态：
          1) 时钟（默认）：居中显示 HH:mm:ss，宽度 320；
          2) 监测区：有正计时 / 倒计时在跑 —— **时钟消失**，改成「模式图标 + mm:ss」，宽度 172。

        第二个计时**不在这里**：它是一颗独立的圆形小岛（<see cref="TimerDotControl"/>），
        由外壳摆在胶囊左边；闹钟不算占用（见 TimeToolsViewModel）。

        形态 = 内容 + 宽度：内容做 Fast 档淡入淡出 + 6px 位移；
        宽度由外壳用弹簧插值（窗口区域跟着变），这里只发 <see cref="PreferredWidthChanged"/>。
    -->
    <Grid x:Name="Root" Background="{x:Null}">

        <!-- 1) 时钟 -->
        <Grid x:Name="ClockView">
            <TextBlock
                Text="{x:Bind ViewModel.CurrentTime, Mode=OneWay}"
                FontFamily="{x:Bind ViewModel.FontFamily}"
                FontSize="{x:Bind ViewModel.FontSize}"
                FontWeight="SemiBold"
                Foreground="{x:Bind ViewModel.ForegroundBrush}"
                IsTextScaleFactorEnabled="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextAlignment="Center" />
        </Grid>

        <!-- 2) 监测区：主计时（模式图标 + 读数） -->
        <Grid x:Name="MonitorView" Visibility="Collapsed">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Grid Width="16" Height="16" VerticalAlignment="Center">
                    <Path
                        x:Name="PrimaryStopwatchIcon"
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Stroke="{ThemeResource AccentTextBrush}"
                        StrokeThickness="{ThemeResource IconStrokeThickness}"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        Data="M 9,4 L 15,4 M 12,4 L 12,7.2 M 12,21 A 7.2,7.2 0 1 0 11.99,21 M 12,11.5 L 12,15.2 M 12,15.2 L 15,16.8" />

                    <Path
                        x:Name="PrimaryCountdownIcon"
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Stroke="{ThemeResource WarningTextBrush}"
                        StrokeThickness="{ThemeResource IconStrokeThickness}"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        Visibility="Collapsed"
                        Data="M 7,3.5 L 17,3.5 M 7,20.5 L 17,20.5 M 8,4.5 C 8,9.5 12,10.5 12,12 C 12,13.5 8,14.5 8,19.5 M 16,4.5 C 16,9.5 12,10.5 12,12 C 12,13.5 16,14.5 16,19.5" />
                </Grid>

                <TextBlock
                    x:Name="PrimaryReadout"
                    FontFamily="Cascadia Code"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AccentTextBrush}"
                    IsTextScaleFactorEnabled="False"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
