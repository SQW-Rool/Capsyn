<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    本文件只做两件事，目的是让「Visual Studio 里还原」和「命令行离线还原」都不报错：

    1) packageSources：正常保留官方源，这样在 VS 里以后还能装新包。
    2) fallbackPackageFolders：把本机 NuGet 缓存当作只读兜底。Capsyn 用到的
       Windows App SDK / Windows SDK 包都已经在这个缓存里，所以没有外网也能还原。
    3) globalPackagesFolder：新解出来的包放在项目内的 .tools\nuget-packages（已被 .gitignore 忽略），
       不改动项目目录之外的任何位置。

    注：.NET SDK 不再需要下载 RID 专用「运行时包」了，原因见 Capsyn.csproj 里的
    EnableRuntimePackDownload / DisableTransitiveFrameworkReferenceDownloads 注释。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <fallbackPackageFolders>
    <clear />
    <add key="machineNuGetCache" value="C:\Users\sqw-j\.nuget\packages" />
  </fallbackPackageFolders>

  <config>
    <add key="globalPackagesFolder" value=".tools\nuget-packages" />
  </config>
</configuration>
