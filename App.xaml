<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Capsyn.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!--
                    Phase 1：统一视觉 token（颜色 / 圆角 / 间距 / 字体层级 / 图标尺寸 / 动效时长与缓动）。
                    控件与页面只引用这里的 key，不再写死色值和数值。
                    依据与取舍写在 Themes/Tokens.xaml 顶部注释里。
                -->
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                岛永远是黑色，所以整个应用固定走深色主题：
                否则控件会跟随系统主题，浅色主题下按钮/开关/提示条都是浅色底，在纯黑上很突兀
                （看板里那些半透明白的指针态资源，就是在手工补这个洞）。
            -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="Transparent" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
